generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  collegeName String   @default("Institute of Technology") @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  users User[]

  @@map("departments")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(255)
  email        String  @unique @db.VarChar(320)
  passwordHash String  @db.VarChar(255)
  role         String  @default("STUDENT") @db.VarChar(50) // 'STUDENT', 'ALUMNI', 'ADMIN'
  isActive     Boolean @default(true)
  departmentId String  @db.Uuid

  studentNumber String? @db.VarChar(100)
  batchYear     Int?

  graduationYear Int?
  currentCompany String? @db.VarChar(255)
  jobTitle       String? @db.VarChar(255)

  skills String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  posts          Post[]
  comments       Comment[]
  postLikes      PostLike[]
  studentMentors Mentorship[]  @relation("StudentMentorships")
  alumniMentors  Mentorship[]  @relation("AlumniMentorships")
  opportunities  Opportunity[] @relation("PostedOpportunities")
  applications   Application[]

  @@index([role])
  @@index([departmentId])
  @@map("users")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  title     String?  @db.VarChar(255)
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    PostLike[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model PostLike {
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_likes")
}
model Mentorship {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @db.Uuid
  alumniId  String   @db.Uuid
  status    String   @default("PENDING") @db.VarChar(50) 
  message   String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  student User @relation("StudentMentorships", fields: [studentId], references: [id], onDelete: Cascade)
  alumni  User @relation("AlumniMentorships", fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([alumniId])
  @@index([status])
  @@map("mentorships")
}
model Opportunity {
  id          String    @id @default(uuid()) @db.Uuid
  postedById  String    @db.Uuid
  title       String    @db.VarChar(255)
  description String    @db.Text
  company     String?   @db.VarChar(255)
  location    String?   @db.VarChar(255)
  type        String    @db.VarChar(50)
  deadline    DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  postedBy     User          @relation("PostedOpportunities", fields: [postedById], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([type])
  @@index([deadline])
  @@map("opportunities")
}

model Application {
  id            String   @id @default(uuid()) @db.Uuid
  opportunityId String   @db.Uuid
  studentId     String   @db.Uuid
  resumeUrl     String?  @db.VarChar(1000)
  status        String   @default("SUBMITTED") @db.VarChar(50)
  appliedAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@index([opportunityId])
  @@index([status])
  @@map("applications")
}
